#!/bin/zsh
# cw — run one driver-seat research/chore task on a cheap pinned model, as an interactive
# Claude Code worker in tmux.
#
#   cw --check                                 exit 0 if cw is enabled on this machine
#   cw <research|chore> <id> <boss>            launch worker cw-<id>; prints its tmux pane id
#   cw --run <job> <id> <boss> <repo> <model> [<provider>]  (inside the pane) exec the worker
#
# Two switches, shared with the cheap-worker mod's /config (CW_PROVIDER / CW_LAUNCH override them):
#   provider  openrouter  any OpenRouter model, key from $CW_OPENROUTER_API_KEY (default)
#             bedrock     Claude via Amazon Bedrock: workers keep user settings, where its env lives
#   launch    panes       tiled in tmux session `cw`, window `workers` (default)
#             tabs        a tmux session `cw-<id>` per worker, opened as a background cmux or
#                         Ghostty tab; `crew <id>` attaches from any terminal
#
# CW_DRY_RUN=1 validates and prints instead of touching git/tmux/claude (used by test-cw.sh).
die() { print -u2 -- "cw: $1"; exit ${2:-2} }

# The mod's saved option: plugin key `cheap-worker` (marketplace install) or `cheap-worker@inline` (plugin dir).
setting() {
  local f=${CW_SETTINGS:-$HOME/.claude/settings.json} k
  for k in cheap-worker cheap-worker@inline; do
    plutil -extract "pluginConfigs.$k.options.$1" raw -o - $f 2>/dev/null && return
  done
}
provider=${CW_PROVIDER:-$(setting provider)}; [[ $provider == bedrock ]] || provider=openrouter
launch=${CW_LAUNCH:-$(setting launch)}; [[ $launch == tabs ]] || launch=panes

# ponytail: models are two variables, not a config file.
if [[ $provider == bedrock ]]; then
  CW_RESEARCH_MODEL=${CW_RESEARCH_MODEL:-haiku} CW_CHORE_MODEL=${CW_CHORE_MODEL:-sonnet}
else
  CW_RESEARCH_MODEL=${CW_RESEARCH_MODEL:-deepseek/deepseek-v4.1-flash}
  CW_CHORE_MODEL=${CW_CHORE_MODEL:-deepseek/deepseek-v4.1-flash}
fi

[[ $1 == --check ]] && { (( $+commands[tmux] )) && [[ $provider == bedrock || -n $CW_OPENROUTER_API_KEY ]]; exit }

if [[ $1 == --run ]]; then
  (( $# == 6 || $# == 7 )) || die "usage: cw --run <job> <task-id> <orchestrator-name> <repo> <model> [<provider>]"
  mode=run job=$2 id=$3 boss=$4 repo=$5 model=$6
  # a pane gets the tmux server's env, not the launcher's: the provider travels as an argument
  provider=${7:-openrouter}
else
  (( $# == 3 )) || die "usage: cw <research|chore> <task-id> <orchestrator-name>"
  mode=launch job=$1 id=$2 boss=$3
  # the caller's checkout: works from a subdir, and a linked worktree is its own checkout
  repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repo"
fi

[[ $job == (research|chore) ]] || die "job must be research or chore, got '$job'"
[[ $id =~ '^[0-9]{3}-[a-z0-9-]+$' ]] || die "task id must look like 012-slug, got '$id'"
[[ $provider == bedrock || -n $CW_OPENROUTER_API_KEY ]] || die "CW_OPENROUTER_API_KEY unset: cw is off on this machine"
ds=$repo/.driver-seat
task=$ds/tasks/$id.md
[[ -f $task ]] || die "missing task file $task"

if [[ $job == research ]]; then
  [[ $mode == launch ]] && model=$CW_RESEARCH_MODEL
  # cwd .driver-seat: acceptEdits then auto-approves edits there only, never in the driver's code
  dir=$ds
  tools=(Read Grep Glob Write Edit WebFetch WebSearch Skill ListAgents SendMessage)
  # denied, not just unlisted: an unlisted shell call waits on a permission prompt nobody answers
  deny=(Bash)
else
  [[ $mode == launch ]] && model=$CW_CHORE_MODEL
  deny=()
  dir=$ds/wt/$id
  tools=(Read Grep Glob Write Edit 'Bash(git status:*)' 'Bash(git diff:*)' 'Bash(git add:*)' 'Bash(git commit:*)' Skill ListAgents SendMessage)
  # `test:` from the frontmatter only, trailing comment dropped
  test_cmd=$(awk '/^---$/ {n++; next} n > 1 {exit} n == 1 && sub(/^test:[ \t]*/, "") {sub(/[ \t]+#.*$/, ""); print; exit}' $task)
  [[ -n $test_cmd ]] && tools+=("Bash($test_cmd:*)")
fi

if [[ $mode == run ]]; then
  prompt="You are cw-$id, a $job worker for $boss.
Read $task and do exactly that task."
  [[ $job == research ]] && prompt+="
Repo under study: $repo (read it, never edit it).
You have no shell; use WebFetch, WebSearch, Read, Grep and Glob."
  prompt+="
Scratch files go in $ds/tmp/ only.
Write your result to $ds/results/$id.md.
If blocked, SendMessage to $boss: \"blocked $id: <question>\" and wait.
When done, SendMessage to $boss: \"done $id\" plus a summary of at most 5 lines."
  if [[ $provider == openrouter ]]; then
    export ANTHROPIC_BASE_URL=https://openrouter.ai/api ANTHROPIC_AUTH_TOKEN=$CW_OPENROUTER_API_KEY ANTHROPIC_API_KEY=
    export ANTHROPIC_DEFAULT_OPUS_MODEL=$model ANTHROPIC_DEFAULT_SONNET_MODEL=$model
    export ANTHROPIC_DEFAULT_HAIKU_MODEL=$model CLAUDE_CODE_SUBAGENT_MODEL=$model
    # no --bare: it turns off cross-session messaging. Skipping user settings drops the user's hooks
    # and plugins instead (Phase 0).
    lean=(--model sonnet --setting-sources project,local)
    # The driver's own skills without the rest of user settings: a folder holding only .claude/skills
    # (a link to ~/.claude/skills), added with --add-dir. Edits there are denied: acceptEdits would
    # auto-approve them, and the link leads to the real skills.
    S=$HOME/.claude/cw-skills
    [[ -n $CW_DRY_RUN ]] || { mkdir -p $S/.claude && ln -sfn $HOME/.claude/skills $S/.claude/skills }
    skills=($S)
    deny+=("Edit(/$S/**)" "Edit(/$HOME/.claude/skills/**)" "Edit(/$HOME/.agents/skills/**)")
  else
    # Bedrock's env (CLAUDE_CODE_USE_BEDROCK, AWS_*) lives in user settings: they must load.
    # The model is a Claude Code alias (haiku/sonnet/opus) or a Bedrock model id.
    lean=(--model $model)
  fi
  # --permission-mode stays last: --allowedTools and --add-dir are variadic and would swallow the prompt.
  cmd=(claude -n cw-$id $lean --strict-mcp-config
       --allowedTools ${(j:,:)tools} ${deny:+--disallowedTools} $deny --add-dir $ds $skills --permission-mode acceptEdits $prompt)
  [[ -n $CW_DRY_RUN ]] && { print -l -- "model=$model" $cmd; exit 0 }
  exec command $cmd  # `command`: skip any `claude` shell function, e.g. one defined in ~/.zshenv
fi

if [[ $job == chore ]]; then
  git -C $repo show-ref --quiet --verify refs/heads/cw/$id && die "branch cw/$id already exists"
  [[ -e $dir ]] && die "$dir already exists"
fi
base=$(git -C $repo rev-parse HEAD)
[[ -n $CW_DRY_RUN ]] && { print -l -- "repo=$repo" "dir=$dir" "base=$base" "provider=$provider" "launch=$launch" "model=$model"; exit 0 }

# from here on a failure undoes the chore's branch and worktree, so the relaunch starts clean
fail() {
  if [[ $job == chore ]]; then
    git -C $repo worktree remove --force $dir
    git -C $repo branch -q -D cw/$id
  fi
  die "$1" 1
}

common=$(git -C $repo rev-parse --path-format=absolute --git-common-dir)
mkdir -p $ds/results $ds/tmp $common/info
grep -qx '.driver-seat/' $common/info/exclude 2>/dev/null || print '.driver-seat/' >> $common/info/exclude
[[ $job == chore ]] && { git -C $repo worktree add -q -b cw/$id $dir $base || die "git worktree add failed" 1 }

# model and provider travel in the run string: a tmux pane gets the server's env, not this caller's
run="exec ${(q)${0:A}} --run $job $id ${(q)boss} ${(q)repo} ${(q)model} $provider"
if [[ $launch == tabs ]]; then
  tmux has-session -t "=cw-$id" 2>/dev/null && fail "tmux session cw-$id already exists"
  pane=$(tmux new-session -d -s cw-$id -x 200 -y 50 -c $dir -P -F '#{pane_id}' $run)
elif ! tmux has-session -t cw 2>/dev/null; then
  pane=$(tmux new-session -d -s cw -n workers -x 200 -y 50 -c $dir -P -F '#{pane_id}' $run)
elif ! tmux list-windows -t cw -F '#W' | grep -qx workers; then
  pane=$(tmux new-window -t cw: -n workers -c $dir -P -F '#{pane_id}' $run)
else
  pane=$(tmux split-window -d -t cw:workers -c $dir -P -F '#{pane_id}' $run)
fi
[[ -n $pane ]] || fail "tmux could not open a pane"
# the cheap-worker mod's tags: its /workers, /progress and /map views and `crew` list these panes too
[[ $provider == bedrock ]] && tag=anthropic/$model || tag=$model
tmux set -p -t $pane @cw cw-$id \; set -p -t $pane @cw_model $tag \; set -p -t $pane @cw_mode acceptEdits \; \
  set -p -t $pane @cw_start $(( $(date +%s) * 1000 )) \; set -p -t $pane @cw_cwd $dir \; set -p -t $pane @cw_task "$job $id"
if [[ $launch == tabs ]]; then
  tmux set -w -t "=cw-$id:" remain-on-exit on
else
  tmux set -t cw mouse on \; \
    set -w -t cw:workers pane-border-status top \; set -w -t cw:workers pane-border-format ' #{@cw} ' \; \
    set -w -t cw:workers remain-on-exit on \; select-layout -t cw:workers tiled
fi

# A background tab attached to session $1: cmux's CLI inside cmux, else Ghostty's AppleScript.
# tmux by absolute path (a tab's command gets no Homebrew PATH); '=…' quoted (zsh expands a bare =word).
open_tab() {
  local tp=${commands[tmux]} ref cm=${CMUX_BUNDLED_CLI_PATH:-cmux}
  if [[ -n ${CMUX_WORKSPACE_ID:-} ]]; then
    ref=$($cm new-surface --type terminal --focus false 2>/dev/null | grep -o 'surface:[0-9]*' | head -1)
    [[ -n $ref ]] || return 1
    $cm rename-tab --surface $ref $1 >/dev/null 2>&1
    $cm send --surface $ref "$tp attach -t '=$1'"$'\n' >/dev/null 2>&1
    return
  fi
  # the first run waits on macOS's "allow control of Ghostty?" dialog: give up after 15 s
  osascript -e "tell application \"Ghostty\"
    set cfg to new surface configuration
    set command of cfg to \"$tp attach -t =$1\"
    if (count of windows) is 0 then
      new window with configuration cfg
    else
      set w to front window
      set here to selected tab of w
      new tab in w with configuration cfg
      select tab here
    end if
  end tell" >/dev/null 2>&1 &
  local p=$!
  ( sleep 15; kill $p ) >/dev/null 2>&1 &
  wait $p
}

pp=$(tmux display -p -t $pane '#{pane_pid}')
clean=0
for i in {1..30}; do
  sleep 1
  screen=$(tmux capture-pane -p -t $pane)
  [[ $screen == *("trust this folder"|"Enter to continue")* ]] && break
  [[ $(tmux display -p -t $pane '#{pane_dead}') == 1 ]] && break
  # Claude Code names its messaging socket after its pid: the pane process, or its child when a
  # shell function or PATH shim sits in between (Phase 0 check 6)
  for p in $pp $(pgrep -P $pp); do
    if [[ -S /tmp/cc-socks/$p.sock ]] && (( ++clean >= 2 )); then
      [[ $launch == tabs ]] && ! open_tab cw-$id && print -u2 -- "cw: no tab opened; reach it with CMD+T, then: crew $id"
      print -- $pane; exit 0
    fi
  done
done
print -u2 -- $screen
tmux kill-pane -t $pane
fail "worker cw-$id did not start cleanly (dialog, exit, or 30 s timeout)"
